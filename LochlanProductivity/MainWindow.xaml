<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="LochlanProductivity.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LochlanProductivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LochlanProductivity">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#99F2F3F0" Padding="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER — minimal -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TitleText" Text="Today's Tasks" FontSize="30" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="FutureButton" Content="+ Future" FontSize="13" Padding="14,6" Background="#FF8A9A8B" Foreground="White" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" Click="PlanFutureTask_Click" ToolTipService.ToolTip="Plan a one-time task for a future day"/>
                <Button x:Name="CalendarButton" Content="Calendar" FontSize="13" Padding="14,6" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" Foreground="#FF3A2E28" CornerRadius="8" VerticalAlignment="Center" Click="CalendarViewButton_Click" ToolTipService.ToolTip="See upcoming and recurring tasks by day"/>
                <Button x:Name="PlanningButton" Content="Planning" FontSize="13" Padding="14,6" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" Foreground="#FF3A2E28" CornerRadius="8" VerticalAlignment="Center" Click="PlanningButton_Click" ToolTipService.ToolTip="Break big goals into ordered steps"/>
                <Button x:Name="ScheduledTasksButton" Content="Scheduled" FontSize="13" Padding="14,6" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" Foreground="#FF3A2E28" CornerRadius="8" VerticalAlignment="Center" Click="ScheduledTasks_Click" ToolTipService.ToolTip="Recurring tasks"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="SyncStatusDot" Width="8" Height="8" Fill="#FF8A9A8B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncStatusText" Text="Synced" FontSize="11" FontFamily="Segoe UI Variable Small" Foreground="#FF6B5E52" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="OptionsButton" Content="..." FontSize="16" Padding="10,4" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" Foreground="#FF3A2E28" CornerRadius="8">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="App Groups" Click="ManageAppGroups_Click"/>
                            <MenuFlyoutItem Text="Scheduled Blocking" Click="ManageSchedules_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Blocked Websites" Click="BlockedSitesButton_Click"/>
                            <MenuFlyoutItem Text="Sync Folder" Click="SyncFolderButton_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Export Backup…" Click="ExportBackupButton_Click"/>
                            <MenuFlyoutItem Text="Import Backup…" Click="ImportBackupButton_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Settings" Click="SettingsButton_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="StartupToggleButton" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- FOCUS CARD — frost glass (semi-transparent over Mica) -->
        <Border x:Name="FocusCard" Grid.Row="1" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" CornerRadius="14" Padding="16">
            <Border x:Name="FocusAccent" BorderBrush="#FF8E7D6B" BorderThickness="4,0,0,0" CornerRadius="8" Padding="12,2,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="BlockingStatusText" Text="Focus Mode is OFF" FontSize="15" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28"/>
                        <TextBlock x:Name="BlockedAppStatusText" Text="No apps are currently being monitored." FontSize="12" FontFamily="Segoe UI Variable Text" Foreground="#FF6B5E52"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BlockingButton" Content="Start Focus Mode" Click="BlockingButton_Click" Padding="18,8" Background="#FF8A9A8B" Foreground="White" BorderThickness="0" CornerRadius="8"/>
                        <Button x:Name="EmergencyButton" Content="Emergency: Allow YouTube (15m)" Click="EmergencyButton_Click" Visibility="Collapsed" Background="#FFF8F0F0" Foreground="#FFA65D3C" BorderBrush="#FFE8CFCF" BorderThickness="1" CornerRadius="8" FontSize="11" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- NOTIFICATION -->
        <Border x:Name="BlockedAppNotification" Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="12" Background="#FFF8F0F0" BorderBrush="#FFE8CFCF" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="BlockedAppNotificationTitle" FontSize="14" FontWeight="SemiBold" Foreground="#FF2E3440"/>
                <TextBlock x:Name="BlockedAppNotificationMessage" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF5A6460" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- TASK INPUT — frost glass -->
        <Border x:Name="TaskInputBorder" Grid.Row="3" Margin="0,14,0,14" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TaskInput" Grid.Column="0" PlaceholderText="What do you need to do?" Background="White" BorderBrush="#FFE8ECE8" CornerRadius="8" KeyDown="TaskInput_KeyDown"/>
                <!-- Sticky group check-off: one color dot per app group, left of Add -->
                <StackPanel x:Name="TaskGroupStrip" Grid.Column="1" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button x:Name="AddTaskButton" Grid.Column="2" Content="Add" Margin="10,0,0,0" Click="AddTask_Click" Background="#FF8A9A8B" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="16,6"/>
            </Grid>
        </Border>

        <!-- CONTENT — Today on left, Future + Long-term always visible on right -->
        <Grid x:Name="MainContentGrid" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- TODAY -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel x:Name="TaskList" Spacing="10"/>
            </ScrollViewer>

            <!-- RIGHT RAIL — the whole rail scrolls, so Coming Up
                 stays reachable no matter how long the Long-term
                 list grows. -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
             <StackPanel Spacing="18">
                <StackPanel x:Name="LongTermSection" Spacing="8">
                    <TextBlock x:Name="LongTermTitle" Text="Long-term &amp; Notes" FontSize="14" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28" Opacity="0.85"/>
                    <Border x:Name="LongTermInputRow" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LongTermInput" Grid.Column="0" PlaceholderText="Add a long-term goal or note…" Background="White" BorderBrush="#FFE8ECE8" CornerRadius="8" KeyDown="LongTermInput_KeyDown"/>
                            <Button x:Name="AddNoteButton" Grid.Column="1" Content="Add Note" Margin="10,0,0,0" Click="AddLongTerm_Click" Background="#FFE8ECE8" Foreground="#FF3A2E28" BorderThickness="0" CornerRadius="8" Padding="14,6"/>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="LongTermListScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LongTermTaskList" Spacing="10"/>
                    </ScrollViewer>
                    <TextBox x:Name="LongTermNoteBox" Visibility="Collapsed" PlaceholderText="Jot down goals, ideas, reminders…" Background="#CCFAFBF9" BorderBrush="#FFDDE3E0" Foreground="#FF3A2E28" FontFamily="Cambria" FontSize="14" CornerRadius="12" Padding="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" TextChanged="LongTermNoteBox_TextChanged"/>
                </StackPanel>

                <StackPanel x:Name="FutureSection" Spacing="8">
                    <TextBlock x:Name="FutureTitle" Text="Coming Up" FontSize="14" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28" Opacity="0.85"/>
                    <TextBlock x:Name="FutureSubtitle" Text="Tasks scheduled for the future — they’ll appear unmarked on their day." FontSize="11" Foreground="#FF6B5E52" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel x:Name="FutureTaskList" Spacing="10"/>
                </StackPanel>
             </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- PLANNING — pages of ordered, dateless, non-blocking steps -->
        <Grid x:Name="PlanningView" Grid.Row="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- Pages -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PagesHeader" Grid.Row="0" Text="Pages" FontSize="14" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28" Opacity="0.85" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PagesList" Spacing="6"/>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PageInput" Grid.Column="0" PlaceholderText="New page name…" Background="White" BorderBrush="#FFE8ECE8" CornerRadius="8" KeyDown="PageInput_KeyDown"/>
                    <Button x:Name="AddPageButton" Grid.Column="1" Content="Add" Margin="10,0,0,0" Click="AddPage_Click" Background="#FFE8ECE8" Foreground="#FF3A2E28" BorderThickness="0" CornerRadius="8" Padding="14,6"/>
                </Grid>
            </Grid>

            <!-- Steps of the selected page -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Grid.Column="0" Text="Select a page" FontSize="16" FontWeight="SemiBold" FontFamily="Cambria" Foreground="#FF3A2E28" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="DeletePageButton" Grid.Column="1" Content="Delete Page" Margin="10,0,0,0" Click="DeletePage_Click" Background="#FFFFF8F0" Foreground="#FFA65D3C" BorderBrush="#FFE8CFCF" BorderThickness="1" CornerRadius="8" FontSize="11" Padding="10,4" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StepsList" Spacing="8"/>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StepInput" Grid.Column="0" PlaceholderText="Add a step…" Background="White" BorderBrush="#FFE8ECE8" CornerRadius="8" KeyDown="StepInput_KeyDown"/>
                    <Button x:Name="AddStepButton" Grid.Column="1" Content="Add Step" Margin="10,0,0,0" Click="AddStep_Click" Background="#FF8A9A8B" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="14,6"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>

</Window>
